{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "premium"
      ],
      "default": "draft"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "watch_time_hours": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "streaming_unlocks": {
      "type": "number",
      "default": 0
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "unlock_price": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}