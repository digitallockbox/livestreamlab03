{
  "name": "Payout",
  "type": "object",
  "properties": {
    "creator_wallet": {
      "type": "string",
      "description": "Wallet address of the creator this payout belongs to"
    },
    "cycle": {
      "type": "string",
      "description": "Payout cycle label (e.g. 2026-07)"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the earning period covered by this payout"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the earning period covered by this payout"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "team_splits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "cycle",
    "amount"
  ]
}