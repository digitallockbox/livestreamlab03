{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "stream_tip",
        "store_sale",
        "affiliate",
        "video_unlock",
        "audio_boost",
        "podcast",
        "payout",
        "subscription",
        "transfer"
      ]
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "streaming_amount": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "source": {
      "type": "string"
    },
    "sender_wallet": {
      "type": "string",
      "description": "Wallet sending a transfer"
    },
    "recipient_wallet": {
      "type": "string",
      "description": "Wallet receiving a transfer"
    }
  },
  "required": [
    "type",
    "amount"
  ]
}