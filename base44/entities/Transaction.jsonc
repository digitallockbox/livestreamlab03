{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "stream_tip",
        "store_sale",
        "affiliate",
        "video_unlock",
        "audio_boost",
        "podcast",
        "payout",
        "subscription",
        "transfer",
        "topup"
      ]
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "streaming_amount": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "source": {
      "type": "string"
    },
    "sender_wallet": {
      "type": "string",
      "description": "Wallet sending a transfer"
    },
    "recipient_wallet": {
      "type": "string",
      "description": "Wallet receiving a transfer"
    },
    "checkout_id": {
      "type": "string",
      "description": "Wix checkout session id, used to match the order-approved webhook to a pending topup"
    },
    "product_id": {
      "type": "string",
      "description": "Product id for store_sale transactions, used to link order history back to the purchased item"
    },
    "stream_id": {
      "type": "string",
      "description": "Stream this transaction belongs to, for per-stream coin tree distribution"
    }
  },
  "required": [
    "type",
    "amount"
  ]
}