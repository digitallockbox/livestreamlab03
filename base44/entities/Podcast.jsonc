{
  "name": "Podcast",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "listens": {
      "type": "number",
      "default": 0
    },
    "subscribers": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "streaming_boosts": {
      "type": "number",
      "default": 0
    },
    "is_monetized": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}