{
  "name": "AffiliateLink",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "creator_wallet": {
      "type": "string",
      "description": "Wallet of the creator who owns this affiliate link"
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "commission_earned": {
      "type": "number",
      "default": 0
    },
    "streaming_bonus": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "url"
  ]
}