{
  "name": "Product",
  "type": "object",
  "properties": {
    "creator_wallet": {
      "type": "string",
      "description": "Wallet of the creator who owns this product"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Fiat currency for card payments (e.g. USD)"
    },
    "streaming_price": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "sales_count": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Total view/affiliate clicks tracked for this product"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Total recorded purchases/conversions for this product"
    },
    "category": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "own",
        "amazon",
        "custom"
      ],
      "default": "own",
      "description": "Product origin: own digital product, Amazon affiliate, or custom external link"
    },
    "external_url": {
      "type": "string",
      "description": "Affiliate or external URL for amazon & custom products"
    },
    "asin": {
      "type": "string",
      "description": "Amazon ASIN for affiliate products"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name"
  ]
}