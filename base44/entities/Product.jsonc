{
  "name": "Product",
  "type": "object",
  "properties": {
    "creator_wallet": {
      "type": "string",
      "description": "Wallet of the creator who owns this product"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "streaming_price": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "sales_count": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}