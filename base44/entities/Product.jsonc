{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "streaming_price": {
      "type": "number",
      "default": 0
    },
    "file_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "sales_count": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "digital",
        "physical",
        "course",
        "membership",
        "other"
      ],
      "default": "digital"
    }
  },
  "required": [
    "name"
  ]
}