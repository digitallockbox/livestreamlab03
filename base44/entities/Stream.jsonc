{
  "name": "Stream",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Stream title"
    },
    "category": {
      "type": "string",
      "enum": [
        "gaming",
        "music",
        "talk_show",
        "education",
        "creative",
        "sports",
        "tech",
        "other"
      ]
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended"
      ],
      "default": "scheduled"
    },
    "viewer_count": {
      "type": "number",
      "default": 0
    },
    "peak_viewers": {
      "type": "number",
      "default": 0
    },
    "tips_earned": {
      "type": "number",
      "default": 0
    },
    "duration_minutes": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "creator_wallet": {
      "type": "string",
      "description": "Wallet of the creator running the stream"
    },
    "stream_key": {
      "type": "string",
      "description": "RTMP stream key for the ingest server"
    }
  },
  "required": [
    "title",
    "creator_wallet"
  ]
}