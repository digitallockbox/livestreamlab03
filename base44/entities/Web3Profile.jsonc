{
  "name": "Web3Profile",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "On-chain wallet address (0x...)"
    },
    "ens_name": {
      "type": "string",
      "description": "ENS name (e.g. name.eth)"
    },
    "display_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string",
      "description": "Channel banner image URL shown at the top of the public profile"
    },
    "bio": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "none",
        "basic",
        "full"
      ],
      "default": "none"
    },
    "badge_tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "diamond"
      ],
      "default": "bronze"
    },
    "followers": {
      "type": "number",
      "default": 0
    },
    "following": {
      "type": "number",
      "default": 0
    },
    "social_graph": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Creator has completed the guided onboarding (wallet + identity + domain)"
    },
    "bound_domain": {
      "type": "string",
      "description": "Freename domain bound during onboarding (e.g. yourname.livestreamlab)"
    },
    "twitch_username": {
      "type": "string",
      "description": "Twitch channel username"
    },
    "twitter_handle": {
      "type": "string",
      "description": "X (Twitter) handle"
    },
    "connections": {
      "type": "object",
      "description": "Per-platform broadcast connection flags for multi-platform syndication",
      "properties": {
        "youtube": {
          "type": "boolean",
          "default": false
        },
        "twitch": {
          "type": "boolean",
          "default": false
        },
        "x": {
          "type": "boolean",
          "default": false
        },
        "tiktok": {
          "type": "boolean",
          "default": false
        },
        "facebook": {
          "type": "boolean",
          "default": false
        },
        "kick": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {}
    },
    "broadcast_all": {
      "type": "boolean",
      "default": false,
      "description": "Syndicate the master stream to all connected external platforms"
    }
  },
  "required": [
    "wallet_address"
  ]
}