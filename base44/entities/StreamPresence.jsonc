{
  "name": "StreamPresence",
  "type": "object",
  "properties": {
    "stream_id": {
      "type": "string",
      "description": "ID of the stream the viewer is watching"
    },
    "viewer_wallet": {
      "type": "string",
      "description": "Wallet address of the viewer"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the viewer joined the stream"
    },
    "last_ping_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent presence ping timestamp (viewers inactive for 30s+ are not counted)"
    }
  },
  "required": [
    "stream_id",
    "viewer_wallet",
    "last_ping_at"
  ]
}