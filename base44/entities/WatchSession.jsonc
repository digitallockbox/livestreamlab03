{
  "name": "WatchSession",
  "type": "object",
  "properties": {
    "viewer_wallet": {
      "type": "string"
    },
    "creator_wallet": {
      "type": "string"
    },
    "stream_id": {
      "type": "string"
    },
    "tokens_earned": {
      "type": "number",
      "default": 0
    },
    "minutes_watched": {
      "type": "number",
      "default": 0
    },
    "engagement_score": {
      "type": "number",
      "default": 0,
      "description": "Aggregated engagement score (chat messages, likes, boosts) for community coin distribution"
    },
    "subscription_tier": {
      "type": "number",
      "default": 1,
      "description": "Subscription tier weight: 1=basic, 2=plus, 3=premium"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    }
  },
  "required": [
    "viewer_wallet",
    "creator_wallet"
  ]
}